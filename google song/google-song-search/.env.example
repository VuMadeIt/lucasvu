# Copy to .env.local and fill real values. Never commit .env.local.
# Keys are server-only — do NOT prefix with NEXT_PUBLIC_.

# Primary audio recognizer: audd | shazam
ACTIVE_AUDIO_API=audd

# AudD (primary when ACTIVE_AUDIO_API=audd)
AUDD_API_KEY=your_audd_key_here

# RapidAPI Shazam (failover / primary when ACTIVE_AUDIO_API=shazam)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=shazam-api6.p.rapidapi.com

# Power Search LLM (optional; multi-source scoring is the primary path)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional Spotify Client Credentials for multi-source power search
# (iTunes is always used as the zero-key fallback)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
