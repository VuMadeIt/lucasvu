RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=shazam-core.p.rapidapi.com

# Power Search LLM (optional; multi-source scoring is the primary path)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Optional Spotify Client Credentials for multi-source power search
# (iTunes is always used as the zero-key fallback)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
